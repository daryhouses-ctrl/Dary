<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Dary - Email Verification</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Arial, sans-serif;
        background: #f4f6fb;
        padding: 40px 15px;
      }

      .container {
        max-width: 620px;
        margin: auto;
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
      }

      .header {
        background: linear-gradient(135deg, #243b7c, #182a5c);
        text-align: center;
        padding: 40px 30px;
      }

      .logo {
        font-size: 34px;
        font-weight: 700;
        color: #c8a96a;
        letter-spacing: 1px;
      }

      .tagline {
        color: rgba(255, 255, 255, 0.85);
        margin-top: 10px;
        font-size: 14px;
      }

      .content {
        padding: 45px;
      }

      h2 {
        color: #243b7c;
        text-align: center;
        margin-bottom: 15px;
      }

      p {
        color: #666;
        font-size: 15px;
        line-height: 1.8;
        text-align: center;
      }

      .otp-box {
        margin: 35px auto;
        width: 260px;
        padding: 18px;
        background: #faf7f2;
        border: 2px dashed #c8a96a;
        border-radius: 14px;
        text-align: center;
        font-size: 36px;
        font-weight: bold;
        letter-spacing: 10px;
        color: #243b7c;
        font-family: Consolas, monospace;
      }

      .warning {
        margin-top: 25px;
        background: #f8f9fc;
        border-left: 4px solid #c8a96a;
        padding: 18px;
        border-radius: 8px;
        color: #555;
        font-size: 14px;
      }

      .footer {
        background: #f8f8f8;
        text-align: center;
        padding: 25px;
        color: #888;
        font-size: 13px;
        border-top: 1px solid #ececec;
      }

      .brand {
        color: #243b7c;
        font-weight: bold;
      }

      .gold {
        color: #c8a96a;
        font-weight: 600;
      }
    </style>
  </head>

  <body>
    <div class="container">

      <div class="header">
        <div class="logo">Dary</div>
        <div class="tagline">
          Find Your Perfect Home
        </div>
      </div>

      <div class="content">

        <h2>Verify Your Email</h2>

        <p>
          Welcome to <strong>Dary</strong> 👋
        </p>

        <p style="margin-top:15px;">
          Use the verification code below to complete your registration and
          secure your account.
        </p>

        <div class="otp-box">
          <%= otp %>
        </div>

        <p>
          This verification code will expire in
          <span class="gold">2 minutes</span>.
        </p>

        <div class="warning">
          🔒 For your security, never share this verification code with anyone.
          Dary will never ask you for your OTP.
        </div>

      </div>

      <div class="footer">
        © <%= year %> <span class="brand">Dary</span>. All Rights Reserved.
      </div>

    </div>
  </body>
</html>


